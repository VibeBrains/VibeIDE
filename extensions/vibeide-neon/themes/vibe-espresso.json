{
	"$schema": "vscode://schemas/color-theme",
	"name": "Vibe Espresso",
	"type": "dark",
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"parameter": {
			"foreground": "#82b3ba",
			"fontStyle": "italic"
		},
		"property": {
			"foreground": "#c17b9e"
		},
		"property.readonly": {
			"foreground": "#c17b9e"
		},
		"variable": {
			"foreground": "#e9ddcf"
		},
		"variable.readonly": {
			"foreground": "#c17b9e"
		},
		"variable.defaultLibrary": {
			"foreground": "#c17b9e"
		},
		"function": {
			"foreground": "#cbb071"
		},
		"function.defaultLibrary": {
			"foreground": "#cbb071"
		},
		"method": {
			"foreground": "#cbb071"
		},
		"class": {
			"foreground": "#82b3ba"
		},
		"interface": {
			"foreground": "#82b3ba"
		},
		"type": {
			"foreground": "#82b3ba"
		},
		"typeParameter": {
			"foreground": "#82b3ba",
			"fontStyle": "italic"
		},
		"enum": {
			"foreground": "#82b3ba"
		},
		"enumMember": {
			"foreground": "#c17b9e"
		},
		"namespace": {
			"foreground": "#82b3ba"
		},
		"decorator": {
			"foreground": "#cbb071"
		},
		"macro": {
			"foreground": "#cbb071"
		},
		"*.deprecated": {
			"fontStyle": "strikethrough"
		}
	},
	"colors": {
		"focusBorder": "#3a2f26",
		"foreground": "#e9ddcf",
		"widget.shadow": "#120f0d",
		"selection.background": "#c98d5c45",
		"errorForeground": "#c96f5f",
		"textLink.activeForeground": "#d9a06c",
		"textLink.foreground": "#d9a06c",
		"button.background": "#88562d",
		"button.foreground": "#f9f5ee",
		"button.hoverBackground": "#d69e6d",
		"button.secondaryBackground": "#3d3125",
		"button.secondaryForeground": "#e9ddcf",
		"button.border": "#504233",
		"checkbox.background": "#2b211a",
		"checkbox.border": "#554636",
		"dropdown.background": "#2b211a",
		"dropdown.listBackground": "#211a15",
		"dropdown.border": "#3a2f26",
		"input.background": "#2b211a",
		"input.foreground": "#e9ddcf",
		"input.border": "#3a2f26",
		"input.placeholderForeground": "#a3927e",
		"inputOption.activeBackground": "#88562d66",
		"inputOption.activeForeground": "#f9f5ee",
		"inputOption.activeBorder": "#c98d5c",
		"inputValidation.errorBackground": "#5d291f",
		"inputValidation.errorBorder": "#c96f5f00",
		"scrollbar.shadow": "#120f0d",
		"scrollbarSlider.activeBackground": "#8b796355",
		"scrollbarSlider.background": "#8b796333",
		"scrollbarSlider.hoverBackground": "#8b79634d",
		"badge.foreground": "#f9f5ee",
		"badge.background": "#88562d",
		"progressBar.background": "#c98d5c",
		"list.activeSelectionBackground": "#3d3125",
		"list.activeSelectionForeground": "#f9f5ee",
		"list.dropBackground": "#583b2366",
		"list.focusBackground": "#3d3125",
