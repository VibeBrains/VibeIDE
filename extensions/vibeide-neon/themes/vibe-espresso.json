		"list.hoverBackground": "#33281f",
		"list.hoverForeground": "#f2e8da",
		"list.inactiveSelectionBackground": "#33281f",
		"list.inactiveSelectionForeground": "#e9ddcf",
		"list.inactiveFocusBackground": "#33281f99",
		"list.errorForeground": "#c96f5f",
		"list.warningForeground": "#d4a94e",
		"activityBar.background": "#1c1612",
