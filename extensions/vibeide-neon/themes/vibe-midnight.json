		"peekViewEditor.matchHighlightBackground": "#7aa2f744",
		"peekViewResult.background": "#1a1e2b",
		"peekViewResult.matchHighlightBackground": "#7aa2f744",
		"peekViewResult.selectionBackground": "#272c3d",
		"peekViewTitle.background": "#1a1e2b",
		"panel.background": "#171923",
		"panel.border": "#1e2231",
