	"tokenColors": [
		{
			"name": "Comment",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#565f89", "fontStyle": "italic" }
		},
		{
			"name": "Comment keyword (TODO, FIXME)",
			"scope": ["keyword.codetag", "comment keyword.other"],
			"settings": { "foreground": "#e0af68", "fontStyle": "italic" }
		},
		{
			"name": "String",
			"scope": ["string", "string.quoted", "punctuation.definition.string"],
			"settings": { "foreground": "#9ece6a" }
		},
		{
			"name": "Template string punctuation",
			"scope": ["punctuation.definition.template-expression", "meta.template.expression"],
			"settings": { "foreground": "#7dcfff" }
		},
		{
			"name": "Escape sequence",
			"scope": ["constant.character.escape"],
			"settings": { "foreground": "#89ddff" }
		},
		{
			"name": "Number and language constant",
			"scope": ["constant.numeric", "constant.language", "constant.character", "keyword.other.unit"],
			"settings": { "foreground": "#ff9e64" }
		},
		{
			"name": "Constant name",
			"scope": ["variable.other.constant", "entity.name.constant"],
			"settings": { "foreground": "#ff9e64" }
		},
		{
			"name": "Keyword and storage",
			"scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"],
			"settings": { "foreground": "#bb9af7" }
		},
		{
			"name": "Import and export",
			"scope": ["keyword.control.import", "keyword.control.export", "keyword.control.from"],
			"settings": { "foreground": "#bb9af7", "fontStyle": "italic" }
		},
		{
			"name": "Operator and punctuation",
			"scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "meta.brace"],
			"settings": { "foreground": "#89ddff" }
		},
		{
			"name": "Function and method",
			"scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
			"settings": { "foreground": "#7aa2f7" }
		},
		{
			"name": "Type, class, interface",
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
			"settings": { "foreground": "#2ac3de" }
		},
		{
			"name": "Built-in and library type",
			"scope": ["support.type.primitive", "support.type.builtin"],
			"settings": { "foreground": "#2ac3de", "fontStyle": "italic" }
		},
		{
			"name": "Variable",
			"scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
			"settings": { "foreground": "#c4cbe3" }
		},
		{
			"name": "Parameter",
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#e0c9a6", "fontStyle": "italic" }
		},
		{
			"name": "This, self, super",
			"scope": ["variable.language.this", "variable.language.self", "variable.language.super"],
			"settings": { "foreground": "#f7768e", "fontStyle": "italic" }
		},
		{
			"name": "Property and object key",
			"scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
			"settings": { "foreground": "#7dcfff" }
		},
		{
			"name": "Tag name",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#f7768e" }
		},
		{
			"name": "Tag attribute",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#bb9af7", "fontStyle": "italic" }
		},
		{
			"name": "Tag punctuation",
			"scope": ["punctuation.definition.tag"],
			"settings": { "foreground": "#5a6595" }
		},
		{
			"name": "CSS selector",
			"scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
			"settings": { "foreground": "#bb9af7" }
		},
		{
			"name": "CSS property",
			"scope": ["support.type.property-name.css"],
			"settings": { "foreground": "#7aa2f7" }
		},
		{
			"name": "Markdown heading",
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#7aa2f7", "fontStyle": "bold" }
		},
		{
			"name": "Markdown bold",
			"scope": ["markup.bold"],
			"settings": { "foreground": "#e0af68", "fontStyle": "bold" }
		},
		{
			"name": "Markdown italic",
			"scope": ["markup.italic"],
			"settings": { "foreground": "#e0af68", "fontStyle": "italic" }
		},
		{
			"name": "Markdown link",
			"scope": ["markup.underline.link", "string.other.link"],
			"settings": { "foreground": "#2ac3de" }
		},
		{
			"name": "Markdown code",
			"scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
			"settings": { "foreground": "#9ece6a" }
		},
		{
			"name": "Markdown quote",
			"scope": ["markup.quote"],
			"settings": { "foreground": "#565f89", "fontStyle": "italic" }
		},
		{
			"name": "Markdown list bullet",
			"scope": ["punctuation.definition.list.begin.markdown"],
			"settings": { "foreground": "#7aa2f7" }
		},
		{
			"name": "Diff inserted",
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#9ece6a" }
		},
		{
			"name": "Diff deleted",
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#e06c75" }
		},
		{
			"name": "Diff changed",
			"scope": ["markup.changed"],
			"settings": { "foreground": "#e0af68" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#e06c75" }
		},
		{
			"name": "Deprecated",
			"scope": ["invalid.deprecated"],
			"settings": { "foreground": "#e0af68", "fontStyle": "strikethrough" }
		},
		{
			"name": "Regular expression",
			"scope": ["string.regexp", "constant.other.character-class.regexp"],
			"settings": { "foreground": "#b4f9f8" }
		},
		{
			"name": "Decorator and annotation",
			"scope": ["meta.decorator", "punctuation.decorator", "storage.type.annotation"],
			"settings": { "foreground": "#e0af68", "fontStyle": "italic" }
		},
		{
			"name": "JSON key",
			"scope": ["support.type.property-name.json"],
			"settings": { "foreground": "#7aa2f7" }
		},
		{
			"name": "YAML key",
			"scope": ["entity.name.tag.yaml"],
			"settings": { "foreground": "#7aa2f7" }
		},
		{
			"name": "Shell built-in",
			"scope": ["support.function.builtin.shell", "entity.name.function.shell"],
			"settings": { "foreground": "#7aa2f7" }
		},
		{
			"name": "Namespace and module",
			"scope": ["entity.name.namespace", "entity.name.module", "support.module"],
			"settings": { "foreground": "#2ac3de" }
		}
	],
	"semanticTokenColors": {
		"parameter": { "foreground": "#e0c9a6", "fontStyle": "italic" },
		"property": { "foreground": "#7dcfff" },
		"variable.readonly": { "foreground": "#ff9e64" },
		"function": { "foreground": "#7aa2f7" },
		"method": { "foreground": "#7aa2f7" },
		"class": { "foreground": "#2ac3de" },
		"interface": { "foreground": "#2ac3de" },
		"enumMember": { "foreground": "#ff9e64" },
		"namespace": { "foreground": "#2ac3de" }
	}
}
