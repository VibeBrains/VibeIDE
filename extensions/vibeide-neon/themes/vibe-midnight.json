		"panelTitle.activeForeground": "#f2f5fb",
		"panelTitle.inactiveForeground": "#767e9c",
		"statusBar.background": "#151824",
		"statusBar.foreground": "#b3bad2",
		"statusBar.border": "#1e2231",
		"statusBar.debuggingBackground": "#4a6fb5",
		"statusBar.debuggingForeground": "#f2f5fb",
		"statusBar.noFolderBackground": "#151824",
		"statusBarItem.prominentBackground": "#272c3d",
		"statusBarItem.prominentHoverBackground": "#313850",
		"statusBarItem.remoteBackground": "#4a6fb5",
		"statusBarItem.remoteForeground": "#f2f5fb",
		"titleBar.activeBackground": "#151824",
		"titleBar.activeForeground": "#c4cbe3",
		"titleBar.inactiveBackground": "#151824",
		"titleBar.inactiveForeground": "#6b7391",
		"titleBar.border": "#1e2231",
		"commandCenter.foreground": "#c4cbe3",
		"commandCenter.background": "#1a1e2b",
		"commandCenter.border": "#343a50",
		"commandCenter.inactiveForeground": "#767e9c",
		"commandCenter.inactiveBorder": "#272c3d",
		"commandCenter.activeForeground": "#f2f5fb",
		"commandCenter.activeBackground": "#1e2231",
		"commandCenter.activeBorder": "#7aa2f7",
		"extensionButton.prominentBackground": "#4a6fb5",
		"extensionButton.prominentHoverBackground": "#5980c8",
		"pickerGroup.foreground": "#8fb6f5",
		"pickerGroup.border": "#343a50",
		"quickInput.background": "#1a1e2b",
		"quickInput.foreground": "#c4cbe3",
		"terminal.background": "#171923",
		"terminal.foreground": "#c4cbe3",
		"terminal.ansiBlack": "#151824",
		"terminal.ansiBlue": "#7aa2f7",
		"terminal.ansiBrightBlack": "#565f89",
		"terminal.ansiBrightBlue": "#8fb6f5",
		"terminal.ansiBrightCyan": "#89ddff",
		"terminal.ansiBrightGreen": "#b3e07f",
		"terminal.ansiBrightMagenta": "#c9a7f0",
		"terminal.ansiBrightRed": "#ef8189",
		"terminal.ansiBrightWhite": "#f2f5fb",
		"terminal.ansiBrightYellow": "#e9c27f",
		"terminal.ansiCyan": "#7dcfff",
		"terminal.ansiGreen": "#9ece6a",
		"terminal.ansiMagenta": "#bb9af7",
		"terminal.ansiRed": "#e06c75",
		"terminal.ansiWhite": "#c4cbe3",
		"terminal.ansiYellow": "#e0af68",
		"terminal.selectionBackground": "#2b334c",
		"terminalCursor.background": "#171923",
		"terminalCursor.foreground": "#c8d3f5",
		"debugToolBar.background": "#1e2231",
		"walkThrough.embeddedEditorBackground": "#171923",
		"gitDecoration.modifiedResourceForeground": "#e0af68",
		"gitDecoration.deletedResourceForeground": "#e06c75",
		"gitDecoration.addedResourceForeground": "#9ece6a",
		"gitDecoration.untrackedResourceForeground": "#9ece6a",
		"gitDecoration.ignoredResourceForeground": "#565f89",
		"minimapGutter.addedBackground": "#9ece6a",
		"minimapGutter.modifiedBackground": "#e0af68",
		"minimapGutter.deletedBackground": "#e06c75",
		"breadcrumb.foreground": "#767e9c",
		"breadcrumb.focusForeground": "#c4cbe3",
		"breadcrumbPicker.background": "#1a1e2b",
		"notifications.background": "#1e2231",
		"notifications.border": "#343a50",
		"notificationCenterHeader.background": "#1a1e2b",
		"keybindingLabel.background": "#272c3d",
		"keybindingLabel.foreground": "#c4cbe3",
		"keybindingLabel.border": "#343a50"
