	"tokenColors": [
		{
			"name": "Comment",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#6f7679", "fontStyle": "italic" }
		},
		{
			"name": "String",
			"scope": ["string", "string.quoted", "punctuation.definition.string"],
			"settings": { "foreground": "#8fae74" }
		},
		{
			"name": "Escape sequence in string",
			"scope": ["constant.character.escape"],
			"settings": { "foreground": "#cc8242" }
		},
		{
			"name": "Number, boolean, language constant",
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#cc8242" }
		},
		{
			"name": "Keyword, storage, operator keyword",
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.operator.expression"],
			"settings": { "foreground": "#b48ead" }
		},
		{
			"name": "Operator, punctuation",
			"scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
			"settings": { "foreground": "#a9b0b4" }
		},
		{
			"name": "Function and method",
			"scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function"],
			"settings": { "foreground": "#6fa8c7" }
		},
		{
			"name": "Type, class, interface",
			"scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
			"settings": { "foreground": "#d3b884" }
		},
		{
			"name": "Variable and parameter",
			"scope": ["variable", "variable.other", "meta.definition.variable"],
			"settings": { "foreground": "#d4d7d9" }
		},
		{
			"name": "Parameter",
			"scope": ["variable.parameter"],
			"settings": { "foreground": "#c0c5c8" }
		},
		{
			"name": "Property and object key",
			"scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
			"settings": { "foreground": "#9fc4d6" }
		},
		{
			"name": "Tag name",
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#b48ead" }
		},
		{
			"name": "Tag attribute",
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#d3b884" }
		},
		{
			"name": "CSS selector",
			"scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"],
			"settings": { "foreground": "#d3b884" }
		},
		{
			"name": "Markdown heading",
			"scope": ["markup.heading", "entity.name.section"],
			"settings": { "foreground": "#6fa8c7", "fontStyle": "bold" }
		},
		{
			"name": "Markdown bold",
			"scope": ["markup.bold"],
			"settings": { "foreground": "#d3b884", "fontStyle": "bold" }
		},
		{
			"name": "Markdown italic",
			"scope": ["markup.italic"],
			"settings": { "foreground": "#d3b884", "fontStyle": "italic" }
		},
		{
			"name": "Markdown link and code",
			"scope": ["markup.underline.link", "markup.inline.raw", "markup.fenced_code"],
			"settings": { "foreground": "#8fae74" }
		},
		{
			"name": "Diff inserted",
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#7fa86a" }
		},
		{
			"name": "Diff deleted",
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#e05252" }
		},
		{
			"name": "Diff changed",
			"scope": ["markup.changed"],
			"settings": { "foreground": "#5b8fb9" }
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#e05252" }
		},
		{
			"name": "Deprecated",
			"scope": ["invalid.deprecated"],
			"settings": { "foreground": "#d8a657", "fontStyle": "strikethrough" }
		},
		{
			"name": "Regular expression",
			"scope": ["string.regexp", "constant.other.character-class.regexp"],
			"settings": { "foreground": "#87c0be" }
		},
		{
			"name": "Decorator and annotation",
			"scope": ["meta.decorator", "punctuation.decorator", "storage.type.annotation"],
			"settings": { "foreground": "#d8a657" }
		}
	]
}
