* text=auto

LICENSE.txt eol=crlf
ThirdPartyNotices.txt eol=crlf

*.bat eol=crlf
*.cmd eol=crlf
*.ps1 eol=lf
*.sh eol=lf
*.rtf -text
**/*.json linguist-language=jsonc
.vibe/**/*.json text eol=lf
# Sources embedded verbatim into vibeDefaultsManifest.generated.ts — pin to LF so the working-tree
# bytes (and thus the generated manifest) are identical on Windows and macOS. See gen-vibe-defaults.mjs.
.vibe-defaults/** text eol=lf
# Same reason: embedded verbatim into vibeSpecsHelp.generated.ts. See gen-specs-help.mjs.
docs/manuals/specsWorkflow.md text eol=lf

# Custom merge driver for VibeIDE persisted plans. Register once per clone:
#   git config merge.vibe-plan.name "VibeIDE plan merger"
#   git config merge.vibe-plan.driver "node scripts/vibe-plan-merge-driver.js %A %O %B %P"
# See scripts/vibe-plan-merge-driver.js and docs/references-v1/persisted-plan-contract.md.
.vibe/plans/*.plan.md   merge=vibe-plan
.vibe/plans/*.steps.json merge=vibe-plan
