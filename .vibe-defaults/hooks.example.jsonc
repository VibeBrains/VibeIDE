// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/hooks.json — хуки проекта (формат VibeIDE)
//
//  Это ПРИМЕР. Чтобы включить — скопируйте нужные блоки в файл .vibe/hooks.json
//  рядом с этим (комментарии из JSONC при этом уберите: hooks.json — строгий JSON).
//
//  Зачем: правило просит модель вести себя правильно, хук — выполняет вашу
//  команду, и её код выхода решает. «Не трогай migrations/» в правилах —
//  пожелание; хук ниже — запрет, который нельзя уговорить.
//
//  Работает, только если: включена настройка `vibeide.hooks.enabled` (по
//  умолчанию ВЫКЛЮЧЕНА) и папка помечена доверенной. Клонирование чужого
//  репозитория не должно означать выполнение его кода.
//
//  Полная спека с примерами скриптов: docs/manuals/hooksSpec.md
// ─────────────────────────────────────────────────────────────────────────────
{
	"hooks": [
		// 1. Запрет на правку миграций. Скрипт читает JSON со stdin и выходит с
		//    кодом 2, если путь ведёт в migrations/ — см. спеку, там готовый файл.
		{
			"event": "preToolUse",
			"command": "node .vibe/hooks/no-migrations.js",
			"tools": ["edit_file", "rewrite_file", "create_file_or_folder", "delete_file_or_folder"],
			"label": "Миграции только руками"
		},

		// 2. Линтер после каждой правки файла. Код выхода 0 — вывод уйдёт агенту
		//    заметкой; 2 — агент получит требование починить.
		{
			"event": "postToolUse",
			"command": "npm run lint --silent",
			"tools": ["edit_file", "rewrite_file"],
			"timeoutMs": 60000,
			"label": "ESLint"
		},

		// 3. Тесты в конце хода. turnEnd не может отменить сделанное — он говорит
		//    агенту, что именно теперь красное.
		{
			"event": "turnEnd",
			"command": "npm test --silent",
			"timeoutMs": 300000,
			"label": "Тесты"
		}

		// Коды выхода: 0 — можно (stdout уйдёт заметкой), 2 — отказ (stderr станет
		// причиной), любой другой код, таймаут или несостоявшийся запуск — поломка
		// самого хука: работа продолжится, а вы увидите предупреждение. Единица не
		// блокирует намеренно: её возвращает любой сломанный скрипт.
	]
}
