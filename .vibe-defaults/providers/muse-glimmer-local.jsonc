// Muse Glimmer 30B (Meta, 10.08.2026) — открытая модель под Apache 2.0 для локальных агентов.
// 30B, контекст 131K+, вход текст и изображения, выход текст. Ключ не нужен: всё локально.
//
// ⚠️ ГЛАВНОЕ ПРО ЭТУ МОДЕЛЬ — ФОРМАТ ВЫЗОВА ИНСТРУМЕНТОВ.
// Glimmer отдаёт вызовы инструментов НЕ в JSON, а XML-подобной разметкой ATEM, и размышление
// шлёт отдельным каналом. Из IDE это выглядит так, будто модель просто не умеет инструменты:
// вызовы приходят обычным текстом. Правкой этого файла симптом НЕ лечится — разбор делает
// сервер, и запускать его надо с обоими парсерами сразу:
//
//   vllm serve meta-models/Muse-Glimmer-30B \
//     --tool-call-parser muse_glimmer \
//     --reasoning-parser muse_glimmer
//
// Парсеры работают в паре: reasoning-парсер принудительно ставит skip_special_tokens=False, и
// без него маркеры срезаются ещё до разбора — оба канала схлопываются в content, то есть
// размышление и вызовы приезжают перемешанными с ответом.
//
// СКОЛЬКО ПАМЯТИ НУЖНО. Q4-сборка — около 17–20 ГБ на диске, плюс KV-кэш, который растёт с
// длиной контекста. На машине с 16 ГБ модель не запустится; 24 ГБ хватает для Q4 на умеренном
// контексте, 32 ГБ — с запасом. Полная точность требует 55+ ГБ. VibeIDE оценивает это сам:
// в настройках, рядом со списком скачанных моделей Ollama, показан вердикт для вашей машины.
//
// ЧТО ЭТА МОДЕЛЬ УМЕЕТ ХУЖЕ. По замерам вендора она сильна в оркестрации и рассуждении
// (MCP Atlas 75.5, SWE-Bench Pro 51.2), но заметно слабее в терминале и работе с интерфейсом
// (TerminalBench 60.7 против 75.6 у Qwen3.6-27B). Разумное применение — read-only роли:
// разведчик, ревьюер, разметка и чтение кода. Сажать её на роль, которая много работает
// командной строкой, смысла нет.
{
	"version": 1,
	"providers": [
		// Вариант 1 — Ollama. Сборка `-dflash` включает спекулятивное декодирование DFlash:
		// вендор заявляет ускорение 3,1× на RTX 5090 и около 1,9× на M5 Max.
		// На момент выхода Ollama поддерживает Glimmer через движок MLX (Apple Silicon);
		// поддержка остальных платформ заявлена как скорая — проверьте `ollama pull` перед тем,
		// как закладываться на неё.
		{
			"id": "muse-glimmer-ollama",
			"name": "Muse Glimmer 30B (Ollama, локально)",
			"protocol": "openai",
			"baseURL": "http://localhost:11434/v1",
			"auth": "none",
			"order": 60,
			"models": {
				"fetch": false,
				"static": [
					{
						"id": "muse-glimmer:30b-q4_K_M-dflash",
						"name": "Muse Glimmer 30B (Q4, DFlash)",
						"default": true,
						"contextWindow": 131072,
						"toolFormat": "openai",
						"vision": true,
						"systemMessage": "system",
						// Значения из карточки модели — не наши предпочтения, а рекомендация вендора.
						"temperature": 1.0,
						"topP": 0.95,
						"topK": 64,
						"reasoning": { "canTurnOff": true, "effort": ["low", "medium", "high", "xhigh"] },
						// Локальная модель ничего не стоит за токен — нули оставлены явно, чтобы
						// панель расхода не подставляла цену однофамильца из каталога.
						"cost": { "input": 0, "output": 0 }
					},
					{
						"id": "muse-glimmer:30b-mlx",
						"name": "Muse Glimmer 30B (MLX, Apple Silicon)",
						"active": false,
						"contextWindow": 131072,
						"toolFormat": "openai",
						"vision": true,
						"systemMessage": "system",
						"temperature": 1.0,
						"topP": 0.95,
						"topK": 64,
						"reasoning": { "canTurnOff": true, "effort": ["low", "medium", "high", "xhigh"] },
						"cost": { "input": 0, "output": 0 }
					}
				]
			}
		},

		// Вариант 2 — vLLM. Выключен по умолчанию: без флагов парсеров из шапки этого файла
		// инструменты работать не будут, и включать провайдер имеет смысл только после того,
		// как сервер поднят правильно.
		{
			"id": "muse-glimmer-vllm",
			"name": "Muse Glimmer 30B (vLLM, локально)",
			"protocol": "openai",
			"baseURL": "http://localhost:8000/v1",
			"auth": "none",
			"active": false,
			"order": 61,
			"models": {
				"fetch": true,
				"static": [
					{
						"id": "meta-models/Muse-Glimmer-30B",
						"name": "Muse Glimmer 30B (vLLM)",
						"default": true,
						"contextWindow": 131072,
						"toolFormat": "openai",
						"vision": true,
						"systemMessage": "system",
						"temperature": 1.0,
						"topP": 0.95,
						"topK": 64,
						"reasoning": { "canTurnOff": true, "effort": ["low", "medium", "high", "xhigh"] },
						"cost": { "input": 0, "output": 0 }
					}
				]
			}
		}
	]
}
