// Z.AI (Zhipu / GLM) — OpenAI-совместимый API.
// Скопируйте в .vibe/providers.json (или перенесите объект провайдера в свой массив providers).
// Ключ: положите строку ZAI_API_KEY=<ваш-ключ> в .vibe/.env (не коммитится).
//
// ДВА РАЗНЫХ ЭНДПОИНТА — выберите тот, за который вы платите:
//   • /api/coding/paas/v4  — GLM Coding Plan (подписка). Ключ из
//     раздела «Model & Personal Coding Plan» работает ТОЛЬКО здесь. Это дефолт ниже.
//   • /api/paas/v4         — оплата за токены (pay-as-you-go), см. комментарий у baseURL.
//
// Симптом перепутанного эндпоинта — не «неверный ключ», а HTTP 429 с кодом 1113
// «Insufficient balance or no resource package. Please recharge»: подписочный ключ ушёл на
// пер-токенный счёт, где денег нет (проверено живьём 06.08.2026).
{
	"version": 1,
	"providers": [
		{
			"id": "zai",
			"name": "Z.AI (GLM)",
			"protocol": "openai",
			// Coding Plan (подписка). Для оплаты за токены замените обе строки на
			// "https://api.z.ai/api/paas/v4" и "https://api.z.ai/api/paas/v4/models".
			"baseURL": "https://api.z.ai/api/coding/paas/v4",
			"auth": "bearer",
			"apiKeyEnv": "ZAI_API_KEY",
			"docsUrl": "https://docs.z.ai/",
			"apiKeyUrl": "https://z.ai/manage-apikey/apikey-list",
			"order": 50,
			"tags": ["glm", "zhipu"],
			"models": {
				// Каталог z.ai — на <baseURL>/models, не /v1/models → указываем полный URL.
				"fetch": "https://api.z.ai/api/coding/paas/v4/models",
				// Статический fallback (пока каталог не подтянулся / нет ключа).
				"static": [
					{
						"id": "glm-4.6",
						"name": "GLM-4.6",
						"default": true,
						"pinned": true,
						"contextWindow": 200000,
						"maxOutputTokens": 131072,
						"toolFormat": "openai",
						"systemMessage": "system",
						"reasoning": { "canTurnOff": true }
					},
					{
						"id": "glm-4.5",
						"name": "GLM-4.5",
						"contextWindow": 131072,
						"maxOutputTokens": 98304,
						"toolFormat": "openai",
						"systemMessage": "system",
						"reasoning": { "canTurnOff": true }
					},
					{
						"id": "glm-4.5-air",
						"name": "GLM-4.5-Air",
						"contextWindow": 131072,
						"maxOutputTokens": 98304,
						"toolFormat": "openai",
						"systemMessage": "system",
						"reasoning": { "canTurnOff": true }
					},
					{
						"id": "glm-4.5v",
						"name": "GLM-4.5V (vision)",
						"contextWindow": 65536,
						"maxOutputTokens": 16384,
						"toolFormat": "openai",
						"vision": true,
						"systemMessage": "system"
					},
					{
						"id": "glm-4.5-flash",
						"name": "GLM-4.5-Flash",
						"contextWindow": 131072,
						"maxOutputTokens": 98304,
						"toolFormat": "openai",
						"systemMessage": "system"
					}
				]
			}
		}
	]
}
