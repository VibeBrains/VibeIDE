// GPT-5.6 (июль 2026) — три тира одного поколения: Sol (флагман), Terra (баланс), Luna (быстрый
// и самый дешёвый). "openAI" — встроенный id, поэтому блок ПАТЧИТ встроенного провайдера.
// Ключ: OPENAI_API_KEY в .vibe/.env или в переменной окружения ОС.
//
// ЛОВУШКА: голый алиас "gpt-5.6" ведёт на Sol, а не на Terra. Если нужен дешёвый маршрут —
// указывайте полный id тира явно, иначе будете платить по флагманскому тарифу.
//
// Зачем это здесь: Terra и Luna — кандидаты на РУТИНУ (коммит-сообщения, переименования,
// короткие правки, разбор вывода команд), а Sol остаётся на сложные задачи. Раздать модели по
// ролям можно в Настройках → Модели → «Роли агентов», не трогая этот файл.
// Все три тира: контекст 1 050 000, максимальный выход 128 000.
{
	"version": 1,
	"providers": [
		{
			"id": "openAI",
			"name": "OpenAI",
			"apiKeyEnv": "OPENAI_API_KEY",
			"apiKeyUrl": "https://platform.openai.com/api-keys",
			"models": {
				"fetch": true,
				"static": [
					{
						"id": "gpt-5.6-terra",
						"name": "GPT-5.6 Terra (рутина)",
						"default": true,
						"pinned": true,
						"contextWindow": 1050000,
						"maxOutputTokens": 128000,
						"toolFormat": "openai",
						"vision": true,
						"reasoning": { "canTurnOff": true, "effort": ["low", "medium", "high"] },
						"cost": { "input": 2.5, "output": 15 }
					},
					{
						"id": "gpt-5.6-luna",
						"name": "GPT-5.6 Luna (самый дешёвый)",
						"pinned": true,
						"contextWindow": 1050000,
						"maxOutputTokens": 128000,
						"toolFormat": "openai",
						"vision": true,
						"reasoning": { "canTurnOff": true, "effort": ["low", "medium", "high"] },
						"cost": { "input": 1, "output": 6 }
					},
					{
						"id": "gpt-5.6-sol",
						"name": "GPT-5.6 Sol (флагман)",
						"contextWindow": 1050000,
						"maxOutputTokens": 128000,
						"toolFormat": "openai",
						"vision": true,
						"reasoning": { "canTurnOff": true, "effort": ["low", "medium", "high"] },
						"cost": { "input": 5, "output": 30 }
					}
				]
			}
		}
	]
}
