// Meta Model API (Muse Spark 1.2) — платный API Meta. Версия 1.2 вышла 05.08.2026 вместе с
// терминальным агентом Muse Code; 1.1 остаётся доступной, но дефолт здесь — новая.
// Ключ: MODEL_API_KEY=<ключ> в .vibe/.env (так переменная названа в документации Meta).
// Взять: консоль Model API → API keys → Create API key; новым аккаунтам дают $20 кредитов.
//
// ДОСТУП ТОЛЬКО ИЗ США. Preview открыт для американских разработчиков, остальным — лист
// ожидания. Если запросы падают на авторизации из другой страны — дело не в конфиге.
//
// Три маршрута одним ключом:
//   • "meta-muse"             — OpenAI-совместимый /v1/chat/completions, стандартный тариф;
//   • "meta-muse-anthropic"   — нативный Anthropic-совместимый Messages API;
//   • "meta-muse-contributor" — тот же чекпоинт по цене в 12 раз ниже, см. предупреждение ниже.
// Второй маршрут полезен там, где OpenAI-слой вендора расходится в вызове инструментов.
//
// Размышление у модели ОБЯЗАТЕЛЬНО: API отвергает reasoning_effort "none", поэтому
// canTurnOff: false — это поведение вендора, а не наша осторожность.
{
	"version": 1,
	"providers": [
		{
			"id": "meta-muse",
			"name": "Meta Muse Spark",
			"protocol": "openai",
			"baseURL": "https://api.meta.ai/v1",
			"auth": "bearer",
			"apiKeyEnv": "MODEL_API_KEY",
			"apiKeyUrl": "https://dev.meta.ai/docs",
			"order": 50,
			"models": {
				"fetch": false,
				"static": [
					{
						"id": "muse-spark-1.2",
						"name": "Muse Spark 1.2 (1M)",
						"default": true,
						"pinned": true,
						"contextWindow": 1000000,
						"toolFormat": "openai",
						"vision": true,
						"reasoning": { "canTurnOff": false, "effort": ["low", "medium", "high"] },
						// cacheRead заполнен намеренно: кэширование у вендора работает, и в агентном
						// цикле повторяющийся системный промпт попадает в кэш почти на каждом ходе.
						// Без этой ставки панель расхода считала бы такие токены по полной цене.
						"cost": { "input": 1.25, "output": 4.25, "cacheRead": 0.15 }
					},
					{
						"id": "muse-spark-1.1",
						"name": "Muse Spark 1.1 (1M, предыдущая)",
						"active": false,
						"contextWindow": 1000000,
						"toolFormat": "openai",
						"vision": true,
						"reasoning": { "canTurnOff": false, "effort": ["low", "medium", "high"] },
						"cost": { "input": 1.25, "output": 4.25, "cacheRead": 0.15 }
					}
				]
			}
		},

		// Тот же ключ и та же модель, но запросы идут в формате Anthropic Messages
		// (SDK допишет к baseURL путь /v1/messages), а инструменты — anthropic-стилем.
		{
			"id": "meta-muse-anthropic",
			"extends": "meta-muse",
			"name": "Meta Muse Spark (Anthropic-протокол)",
			"protocol": "anthropic",
			"baseURL": "https://api.meta.ai",
			"auth": { "type": "header", "name": "x-api-key" },
			"apiKeyEnv": "MODEL_API_KEY",
			"order": 51,
			"models": {
				"fetch": false,
				"static": [
					{
						"id": "muse-spark-1.2",
						"name": "Muse Spark 1.2 (Anthropic, 1M)",
						"default": true,
						"contextWindow": 1000000,
						"toolFormat": "anthropic",
						"vision": true,
						"reasoning": { "canTurnOff": false, "effort": ["low", "medium", "high"] },
						"cost": { "input": 1.25, "output": 4.25, "cacheRead": 0.15 }
					}
				]
			}
		},

		// ⚠️ ЧЕМ ПЛАТИТЕ ЗА СКИДКУ. Чекпоинт тот же самый, цена ниже в 12,5 раза на входе и в
		// 21 раз на выходе — но Meta оставляет за собой право использовать отправленные промпты
		// и ответы для обучения будущих моделей. Для рабочего кода под NDA это дисквалифицирует
		// тариф целиком; для личных экспериментов и опенсорса — честная сделка.
		// Второе отличие менее заметное, но важное для агентного цикла: лимит 60 запросов в
		// минуту против 3000 на стандартном тарифе. Агент с параллельными ролями упрётся в него
		// быстрее, чем человек в чате, и симптомом будет 429, а не отказ.
		// Провайдер выключен по умолчанию — включите осознанно.
		{
			"id": "meta-muse-contributor",
			"extends": "meta-muse",
			"name": "Meta Muse Spark (Contributor — данные идут на обучение)",
			"active": false,
			"order": 52,
			"models": {
				"fetch": false,
				"static": [
					{
						"id": "muse-spark-1.2-contributor",
						"name": "Muse Spark 1.2 (Contributor, 1M)",
						"default": true,
						"contextWindow": 1000000,
						"toolFormat": "openai",
						"vision": true,
						"reasoning": { "canTurnOff": false, "effort": ["low", "medium", "high"] },
						"cost": { "input": 0.10, "output": 0.20, "cacheRead": 0.002 }
					}
				]
			}
		}
	]
}
