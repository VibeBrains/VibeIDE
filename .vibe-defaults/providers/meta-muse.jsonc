// Meta Model API (Muse Spark 1.1) — первый платный API Meta, открыт в public preview 2026-07-09.
// Ключ: MODEL_API_KEY=<ключ> в .vibe/.env (так переменная названа в документации Meta).
// Взять: консоль Model API → API keys → Create API key; новым аккаунтам дают $20 кредитов.
//
// ДОСТУП ТОЛЬКО ИЗ США. Preview открыт для американских разработчиков, остальным — лист
// ожидания. Если запросы падают на авторизации из другой страны — дело не в конфиге.
//
// Один ключ, два маршрута к одной модели (оригинал и клон через extends):
//   • "meta-muse"           — OpenAI-совместимый /v1/chat/completions;
//   • "meta-muse-anthropic" — нативный Anthropic-совместимый Messages API.
// Второй маршрут полезен там, где OpenAI-слой вендора расходится в вызове инструментов.
//
// Цена $1.25 / $4.25 за 1M токенов — примерно вчетверо дешевле флагманов Anthropic и OpenAI
// при контексте 1M и мультимодальном входе (изображения, видео, PDF).
//
// Размышление у модели ОБЯЗАТЕЛЬНО: API отвергает reasoning_effort "none", поэтому
// canTurnOff: false — это поведение вендора, а не наша осторожность.
{
	"version": 1,
	"providers": [
		{
			"id": "meta-muse",
			"name": "Meta Muse Spark",
			"protocol": "openai",
			"baseURL": "https://api.meta.ai/v1",
			"auth": "bearer",
			"apiKeyEnv": "MODEL_API_KEY",
			"apiKeyUrl": "https://dev.meta.ai/docs",
			"order": 50,
			"models": {
				"fetch": false,
				"static": [
					{
						"id": "muse-spark-1.1",
						"name": "Muse Spark 1.1 (1M)",
						"default": true,
						"pinned": true,
						"contextWindow": 1000000,
						"toolFormat": "openai",
						"vision": true,
						"reasoning": { "canTurnOff": false, "effort": ["low", "medium", "high"] },
						"cost": { "input": 1.25, "output": 4.25 }
					}
				]
			}
		},

		// Тот же ключ и та же модель, но запросы идут в формате Anthropic Messages
		// (SDK допишет к baseURL путь /v1/messages), а инструменты — anthropic-стилем.
		{
			"id": "meta-muse-anthropic",
			"extends": "meta-muse",
			"name": "Meta Muse Spark (Anthropic-протокол)",
			"protocol": "anthropic",
			"baseURL": "https://api.meta.ai",
			"auth": { "type": "header", "name": "x-api-key" },
			"apiKeyEnv": "MODEL_API_KEY",
			"order": 51,
			"models": {
				"fetch": false,
				"static": [
					{
						"id": "muse-spark-1.1",
						"name": "Muse Spark 1.1 (Anthropic, 1M)",
						"default": true,
						"contextWindow": 1000000,
						"toolFormat": "anthropic",
						"vision": true,
						"reasoning": { "canTurnOff": false, "effort": ["low", "medium", "high"] },
						"cost": { "input": 1.25, "output": 4.25 }
					}
				]
			}
		}
	]
}
