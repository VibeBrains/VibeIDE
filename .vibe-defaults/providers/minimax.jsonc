// MiniMax — два маршрута к одним и тем же моделям:
//   1) "minimax" — встроенный id, поэтому первый блок ПАТЧИТ встроенного провайдера
//      (фиксирует список моделей) и ходит по OpenAI-совместимому API;
//   2) "minimax-anthropic" — КЛОН через extends, ходит по нативному Anthropic-совместимому
//      эндпоинту вендора (/anthropic). Оригинал при этом остаётся на месте.
// Ключ в обоих случаях один: apiKeyRef берёт его из защищённых настроек VibeIDE.
{
	"version": 1,
	"providers": [
		{
			"id": "minimax",
			"name": "MiniMax",
			"baseURL": "https://api.minimax.io/v1",
			"apiKeyRef": "minimax",
			"models": {
				"fetch": false,
				"static": [
					{
						"id": "MiniMax-M3",
						"name": "MiniMax M3 (1M)",
						"default": true,
						"pinned": true,
						"contextWindow": 1000000,
						"toolFormat": "openai",
						"vision": true,
						"reasoning": { "canTurnOff": true, "effort": ["low", "high"] },
						"cost": { "input": 0.3, "output": 1.2 }
					}
				]
			}
		},

		// ── MiniMax по нативному протоколу Anthropic ──────────────────────────────
		// Вендор поднял Anthropic-совместимый Messages endpoint: те же модели, но запросы
		// идут в формате Anthropic, а инструменты вызываются anthropic-стилем.
		//
		// ВНИМАНИЕ, baseURL заканчивается на /v1 — это обязательно. SDK дописывает РОВНО
		// «/messages» к тому, что здесь указано (проверено живьём 06.08.2026: с baseURL без
		// /v1 запрос уходил на /anthropic/messages и вендор отвечал 404 Not Found).
		// Прежний комментарий здесь утверждал, будто SDK сам добавляет «/v1/messages», — это
		// было неверно и стоило разбирательства на живом ключе. Зачем: обходит расхождения OpenAI-слоя в tool-use и
		// даёт честный подсчёт токенов через /anthropic/v1/messages/count_tokens.
		// Чего на этом эндпоинте НЕТ (по доке вендора): top_k, stop_sequences, mcp_servers,
		// context_management, container и серверные инструменты вроде web_search.
		// Размышление приходит thinking-блоками — их обязательно возвращать без изменений
		// в следующем запросе с вызовом инструмента (у нас это делает квирк minimax).
		{
			"id": "minimax-anthropic",
			"extends": "minimax",
			"name": "MiniMax (Anthropic-протокол)",
			"protocol": "anthropic",
			"baseURL": "https://api.minimax.io/anthropic/v1",
			"auth": { "type": "header", "name": "x-api-key" },
			"apiKeyRef": "minimax",
			"order": 30,
			"models": {
				"fetch": false,
				"static": [
					{
						"id": "MiniMax-M3",
						"name": "MiniMax M3 (Anthropic, 1M)",
						"default": true,
						"contextWindow": 1000000,
						"toolFormat": "anthropic",
						"vision": true,
						"reasoning": { "canTurnOff": true, "effort": ["low", "high"] },
						"cost": { "input": 0.3, "output": 1.2 }
					}
				]
			}
		}
	]
}
