// Moonshot / Kimi — OpenAI-совместимый API, «думающая» модель.
// Рецепт reasoning: слайдер усилия (reasoning.effort → reasoning_effort) + сам режим
// thinking у Moonshot включается отдельным полем в extraBody (уходит в тело как есть).
// Ключ: MOONSHOT_API_KEY=<ключ> в .vibe/.env.
//
// K3 (2.8T параметров MoE — активно 16 из 896 экспертов, контекст 1M, веса под Modified MIT
// обещаны на 2026-07-27) — лидер Frontend Code arena, берите её под фронтенд-задачи. Две
// особенности, которые бьют по бюджету: у K3 ОДИН уровень reasoning effort — дословно "max",
// выключить размышление нельзя, и на простую задачу уходит порядка 13 тысяч токенов рассуждений.
// Поэтому canTurnOff: false и единственное значение effort — это не упрощение записи, а
// фактическое поведение модели (значение уходит в reasoning_effort как есть, "high" API не знает).
// Для рутины она невыгодна.
// Self-host: 2.8T параметров на рабочую станцию не кладутся, ориентируйтесь на API.
{
	"version": 1,
	"providers": [
		{
			"id": "kimi",
			"name": "Kimi (Moonshot)",
			"protocol": "openai",
			"baseURL": "https://api.moonshot.ai/v1",
			"auth": "bearer",
			"apiKeyEnv": "MOONSHOT_API_KEY",
			"apiKeyUrl": "https://platform.moonshot.ai/console/api-keys",
			"order": 60,
			"models": {
				"fetch": true,
				"static": [
					{
						"id": "kimi-k3",
						"name": "Kimi K3 (1M, фронтенд)",
						"pinned": true,
						"contextWindow": 1048576,
						"maxOutputTokens": 32768,
						"toolFormat": "openai",
						// Три уровня подтверждены вендором (platform.kimi.ai, проверено 2026-08-05):
						// «Reasoning effort supports low, high, and max (default max)». На запуске K3 был
						// только "max" — обещанные режимы вышли. Уровня "medium" у K3 НЕТ (в отличие от
						// K2.7 ниже) — значение уезжает в API дословно, без нормализации.
						// Выключить размышление нельзя в принципе, поэтому уровень — единственный рычаг
						// экономии на этой модели.
						"reasoning": { "canTurnOff": false, "effort": ["low", "high", "max"] },
						"cost": { "input": 3, "output": 15 }
					},
					{
						"id": "kimi-k2.7-code",
						"name": "Kimi K2.7 Code",
						"default": true,
						"contextWindow": 262144,
						"maxOutputTokens": 32768,
						"toolFormat": "openai",
						"reasoning": { "canTurnOff": true, "effort": ["low", "medium", "high"] },
						"extraBody": { "thinking": { "type": "enabled" } }
					}
				]
			}
		}
	]
}
