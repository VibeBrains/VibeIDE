// Пример: пайплайн — последовательность шагов, где каждый выполняет агент со своей ролью,
// а следующий подхватывает то, что сделал предыдущий.
//
// Переименуйте в pipelines.json (или скопируйте нужный пайплайн в свой файл) и правьте под себя.
// Полный формат — docs/manuals/pipelinesSpec.md (файл можно целиком скормить модели и попросить
// собрать свой пайплайн).
//
// Как передаются артефакты: следующему шагу уходят ПУТИ файлов, которых касались предыдущие шаги,
// и резюме последнего шага. Содержимое файлов не вставляется — агент прочитает нужное сам, иначе
// на третьем шаге переполнился бы контекст.
//
// Провал шага по умолчанию останавливает пайплайн: иначе следующий шаг работает в предположении,
// что предыдущий удался. Оставшиеся шаги попадут в отчёт со статусом «пропущен».
{
	"version": 1,
	"pipelines": [
		{
			"id": "feature",
			"name": "Фича под ключ",
			"description": "Спроектировать → реализовать → проверить",
			"steps": [
				{
					"role": "planner",
					"task": "Разбери задачу на шаги и запиши план в docs/plan.md"
				},
				{
					"role": "backend-dev",
					"task": "Реализуй по плану из предыдущего шага",
					"acceptance": "Проект собирается, типы проходят"
				},
				{
					"role": "code-reviewer",
					"task": "Найди дефекты в сделанных изменениях"
				}
			]
		},
		{
			"id": "review",
			"name": "Независимое ревью",
			"description": "Проверяющий намеренно не идёт по следам автора",
			"steps": [
				{
					"role": "code-reviewer",
					"task": "Найди дефекты в текущих изменениях рабочей папки",
					// Свежий взгляд: шаг не получает ни путей, ни резюме предыдущих шагов.
					"ignorePreviousArtifacts": true
				},
				{
					"role": "qa",
					"task": "Проверь найденное прогоном тестов и опиши, что подтвердилось",
					// Выполнить, даже если ревью завершилось неудачей — шаг самостоятелен.
					"continueOnFailure": true,
					"maxSteps": 20
				}
			]
		}
	]
}
