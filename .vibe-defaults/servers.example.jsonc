// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/servers.json — дев-стек проекта (формат VibeIDE)
//
//  Это ПРИМЕР. Чтобы включить — скопируйте нужные блоки в файл .vibe/servers.json
//  рядом с этим (или переименуйте копию). Формат — JSONC: можно писать // комментарии.
//
//  Зачем: описывает ВСЕ сервисы, которые проект поднимает разом, и порядок их
//  запуска — заменяет самописный dev.sh, который обрастает в любом монорепо.
//  Нет файла — работает как раньше: один автоопределённый сервер.
//
//  Не хотите писать руками — попросите агента в чате:
//    «Создай мне .vibe/servers.json для этого проекта»
//  (полная спека формата — docs/manuals/serversSpec.md, её можно скормить любой LLM).
//
//  Главные принципы:
//   • "id" + "command" — единственные обязательные поля.
//   • "kind": "service" (по умолчанию) — долгоживущий процесс;
//     "task" — одноразовая команда, которая должна УСПЕШНО ЗАВЕРШИТЬСЯ до старта
//     зависящих от неё (докер, миграции, кодоген). Инфраструктура — это task!
//   • Порядок запуска берётся из "dependsOn", а НЕ из порядка в массиве.
//   • Запущенный процесс ≠ готовый: по умолчанию ждём, что откроется "port".
//     Angular/Ionic поднимаются минутами — ставьте "readyTimeoutMs": 420000.
//   • Неизвестный id в "dependsOn" ОТКЛЮЧАЕТ запись (и цикл зависимостей тоже).
//   • Одна битая запись не роняет стек — пропускается с предупреждением.
// ─────────────────────────────────────────────────────────────────────────────
{
	"version": 1,
	"servers": [
		// ─── Минимум: одиночный дев-сервер ──────────────────────────────────
		{
			"id": "web",
			"command": "npm run dev",
			"port": 5173,
			"autoStart": true // стартовать вместе с проектом
		}

		// ─── Монорепо: докер → API → фронтенды ────────────────────────────
		// ,{
		//   "id": "colima",
		//   "kind": "task",                  // одноразовая: подняли докер и всё
		//   "command": "colima start",
		//   "readyCheck": "exit",            // готово = вышла с кодом 0
		//   "skipIf": "docker info"          // уже запущен → пропустить (быстрый рестарт)
		// },
		// {
		//   "id": "api",
		//   "dir": "api",                    // папка относительно корня проекта
		//   "command": "yarn dev",
		//   "port": 3000,
		//   "readyTimeoutMs": 180000,        // тяжёлый бэкенд
		//   "dependsOn": ["colima"],         // не стартовать, пока нет докера
		//   "pathPrepend": ["/opt/homebrew/opt/node@20/bin"], // пин тулчейна
		//   "envFile": ".env.local",
		//   "previewPath": "/dashboard",     // что открыть в превью вместо "/"
		//   "stopCommand": "docker compose down"
		// },
		// {
		//   "id": "admin", "dir": "admin", "command": "npm start",
		//   "port": 4200, "readyTimeoutMs": 420000   // Angular стартует долго
		// }

		// ─── Другие способы понять, что сервис готов ──────────────────────
		// ,{
		//   "id": "next", "command": "npm run dev", "port": 3000,
		//   "readyCheck": "log",             // ждём строку в выводе
		//   "readyPattern": "Ready in"
		// },
		// {
		//   "id": "backend", "dir": "server", "command": "go run ./cmd/api",
		//   "port": 8080,
		//   "readyCheck": "http",            // health-эндпоинт честнее сокета
		//   "readyPath": "/healthz"
		// },
		// {
		//   "id": "migrate", "kind": "task", "dir": "server",
		//   "command": "make migrate", "readyCheck": "exit",
		//   "dependsOn": ["backend"]         // миграции после подъёма БД/бэкенда
		// }

		// ─── Запись можно оставить в файле, но выключить ──────────────────
		// ,{
		//   "id": "storybook", "command": "npm run storybook", "port": 6006,
		//   "active": false,                 // задокументирована, но вне стека
		//   "note": "включаем только когда правим компоненты"
		// }
	]
}
